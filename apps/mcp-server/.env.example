# Environment mode: 'mainnet' or 'devnet'
MODE=devnet

# Solana RPC endpoints
# For mainnet: https://api.mainnet-beta.solana.com
# For devnet: https://api.devnet.solana.com or https://devnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# WebSocket RPC for subscriptions
# For mainnet: wss://api.mainnet-beta.solana.com
# For devnet: wss://devnet.helius-rpc.com/?api-key=YOUR_KEY
WS_RPC_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Your Solana wallet private key (base58 encoded)
# ⚠️ NEVER commit real keys! Use a devnet-only keypair for testing
SOLANA_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY

# Optional: Gemini API for AI features
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Mainnet-specific (only used when MODE=mainnet)
# MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# MAINNET_WS_URL=wss://api.mainnet-beta.solana.com
