# ---------------------------------------------------------------------------
# Hey-Sol · MCP Server (Node.js / stdio MCP tool server)  —  EXAMPLE / TEMPLATE
# Commit this file. Copy to .env and replace placeholder values.
# ---------------------------------------------------------------------------

RPC_URL=https://api.devnet.solana.com

# PostgreSQL connection string (same DB as the web app)
DATABASE_URL=postgresql://user:password@localhost:5433/heysol

# AES-256-GCM key used to decrypt managed wallet private keys (must match web app)
# Generate: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=your_64_char_hex_key_here

# Optional guardrail: maximum SOL per send_sol call.
MAX_SEND_SOL=5
